# Copy to backend/.env (never commit .env). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model IDs change over time - check https://ai.google.dev/gemini-api/docs/models
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Tried once if the chat model is overloaded (503/429). Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768

# RAG tuning
RAG_TOP_K=4
RAG_MIN_SCORE=0.5

# Contact form (Module 5) ------------------------------------------------
# Where messages are delivered (your own inbox):
CONTACT_TO_EMAIL=syedfawwad100@gmail.com
# How to send: resend | smtp | console   (console = print to terminal, for local testing)
EMAIL_PROVIDER=console
#
# Option A, Resend (https://resend.com, free tier). With the default sender below,
# Resend only delivers to the email address you signed up with, which is all this form needs.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
#
# Option B, Gmail SMTP: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Server
PORT=3001
# Comma-separated list of allowed browser origins (localhost dev origins are always allowed)
CLIENT_ORIGINS=https://your-site.vercel.app
# Set to 1 when deployed behind a proxy (Render/Railway) so rate limiting sees real client IPs
TRUST_PROXY=0
